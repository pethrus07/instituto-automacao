node_modules/
.wrangler/
.dev.vars
.env
dist/
*.log

# A colheita e material de leitura de terceiro: fica na maquina, nao no git.
# O livro de lidos e a excecao — e metadado NOSSO (quais URLs ja foram
# lidas), e e ele que impede um item ja descartado de voltar para a pauta.
colheita/*
!colheita/lidos.json

# Gerado por npm run compilar a partir de conteudo/**.md. O fonte e o markdown;
# o .ts e a versao compilada que entra no bundle. dev e deploy o regeneram.
src/conteudo.gerado.ts

# Saida do dry-run do wrangler que o QA usa para conferir o bundle (P1).
dist/

# saída da revisão por medição (screenshots + medidas), regenerável
qa/revisao/

# imagens de compartilhamento rasterizadas pelo compilador (regeneráveis)
publico/og/

# arquivos de trabalho do tour narrado (áudio, gravação bruta, partes) — o vídeo final fica em publico/tour/
tour/.trabalho/
