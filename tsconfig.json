{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    // sitemap.ts importa feed.ts com extensao: e o unico jeito de os modulos
    // de src/ rodarem tambem sob `node --experimental-strip-types`, que e como
    // os testes exercitam o parser sem subir Worker.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // o editor de /escrever roda no NAVEGADOR (tipos de DOM), não no Worker:
  // tem o tsconfig dele em src/escrever/, e `npm run tipos` confere os dois
  "exclude": ["src/escrever/**"]
}
